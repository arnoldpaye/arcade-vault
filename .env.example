# Variables de entorno del formulario de contacto (/acerca).
# Copia este archivo a .env.local y rellena los valores. .env.local no se versiona.

# API key de Resend (https://resend.com/api-keys). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
RESEND_API_KEY=

# Buzón que recibe los mensajes de contacto.
# Con el remitente por defecto onboarding@resend.dev, Resend solo entrega a la dirección
# de la cuenta dueña de la API key, así que usa esa dirección hasta verificar un dominio.
CONTACT_TO_EMAIL=

# Remitente opcional. Por defecto: Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=
