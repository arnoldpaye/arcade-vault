# Variables de entorno del formulario de contacto (/acerca).
# Copia este archivo a .env.local y rellena los valores. .env.local no se versiona.

# API key de Resend (https://resend.com/api-keys). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
RESEND_API_KEY=

# Buzón que recibe los mensajes de contacto.
# Con el remitente por defecto onboarding@resend.dev, Resend solo entrega a la dirección
# de la cuenta dueña de la API key, así que usa esa dirección hasta verificar un dominio.
CONTACT_TO_EMAIL=

# Remitente opcional. Por defecto: Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# --- Supabase ---
# Proyecto remoto: yscfrmyruviwjngwipjl. Valores en el dashboard (Project Settings > API Keys)
# o con el MCP de Supabase (get_project_url, get_publishable_keys).

# URL del proyecto. Pública por diseño.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (formato sb_publishable_…). Pública por diseño: la protección de los datos es RLS.
# No uses aquí la secret key ni la service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (formato sb_secret_…). Solo servidor: la usa únicamente lib/supabase/admin.ts
# para insertar puntuaciones desde la Server Action. Salta RLS: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Contraseña de la base de datos. Solo la usa la CLI (supabase link, comandos --linked), nunca la app.
# Sin prefijo NEXT_PUBLIC_: no debe llegar al navegador.
SUPABASE_DB_PASSWORD=
